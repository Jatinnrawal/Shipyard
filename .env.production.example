# Copy to .env.production on the Linux deployment host. Never commit the real file.
SHIPYARD_DOMAIN=shipyard.example.com
SHIPYARD_PUBLIC_URL=https://shipyard.example.com

# Create with: docker run --rm caddy:2-alpine caddy hash-password --algorithm bcrypt
SHIPYARD_BASIC_AUTH_USER=shipyard-admin
SHIPYARD_BASIC_AUTH_HASH='$2a$14$replace_this_with_a_real_caddy_hash'

# Set this to 1 only while inviting another trusted user to the shared workspace.
SHIPYARD_ALLOW_SIGNUP=0

# Shipyard runs up to two builds/deployments at once (allowed range: 1-4).
SHIPYARD_MAX_CONCURRENT_RELEASES=2

# Optional Google OAuth web client ID. Add https://shipyard.example.com as its JS origin.
GOOGLE_CLIENT_ID=

# Configure both values to enable password-reset email through Resend.
RESEND_API_KEY=
SHIPYARD_FROM_EMAIL=

# kubectl should be within one minor version of the target cluster.
KUBECTL_VERSION=v1.36.5
DOCKER_CLI_VERSION=29.9.3
HELM_VERSION=v4.3.1
